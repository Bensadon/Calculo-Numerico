        "import numpy as np\n",
        "\n",
        "A = np.array([[10, -1,  2],\n",
        "              [-1, 11, -1],\n",
        "              [ 2, -1, 10]], dtype=float)\n",
        "b = np.array([6, 22, -10], dtype=float)\n",
        "\n",
        "def gauss_seidel(A, b, x0, tol=1e-5, max_iter=1000):\n",
        "    n = len(b)\n",
        "    x = x0.astype(float).copy()\n",
        "    historico = [x.copy()]\n",
        "    erros = [np.nan]                      # sem erro para k = 0\n",
        "    for k in range(1, max_iter + 1):\n",
        "        x_old = x.copy()\n",
        "        for i in range(n):\n",
        "            # x[:i] já contém valores da iteração k; x_old[i+1:] são da k-1\n",
        "            soma = A[i, :i] @ x[:i] + A[i, i+1:] @ x_old[i+1:]\n",
        "            x[i] = (b[i] - soma) / A[i, i]\n",
        "        erro = np.max(np.abs(x - x_old))  # norma infinito\n",
        "        historico.append(x.copy())\n",
        "        erros.append(erro)\n",
        "        if erro < tol:\n",
        "            return x, k, np.array(historico), np.array(erros)\n",
        "    return x, max_iter, np.array(historico), np.array(erros)\n",
        "\n",
        "x0 = np.zeros(3)\n",
        "sol, iters, hist, erros = gauss_seidel(A, b, x0)\n",
        "\n",
        "print(\"Iterações:\", iters)\n",
        "print(\"Solução aproximada:\", sol)\n",
        "print(\"Solução exata (np.linalg.solve):\", np.linalg.solve(A, b))"
      ],
